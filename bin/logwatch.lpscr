#!/usr/bin/env -S loup run
@mode(host.scripted)

# logwatch: analyse web server access logs in Common or Combined Log Format.
#
# Runtime: host.scripted. The program's entry point: the Loup scripted
# runtime interprets this file from source (`loup run bin/logwatch.lpscr --
# ARGS`, as `make run`, tests/e2e.sh and CI do; on Linux x86-64 that is the
# self-hosted driver). Its top-level statements run in order and there is no
# compile step: a script entry cannot be compiled, so the project has no
# binary. `make check` type-checks it, with every lib/ module it imports,
# using Stage0 (`loup-bootstrap check`). Long options must follow `--`:
# `loup run` drops a `--long` word that comes before it.
#
# Structure: this script is the top level, the only code that reads files,
# prints and sets the exit status. It parses the command line (usage errors
# exit 2), handles --help and --version, feeds each input to one Analyser,
# builds the requested report tables, prints them in the TableFormat that
# -f names, and finally reports malformed lines. The parsing, counting and
# formatting it calls are the modules in lib/.

from ..lib.appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from ..lib.args import (Options, parse_args);
from ..lib.usage import (usage, version_line);
from ..lib.inputs import (input_problem);
from ..lib.analyse import (Analyser);
from ..lib.reports import (build_reports);
from ..lib.render import (TableFormat, TextFormat, CsvFormat);
from ..lib.render_json import (JsonFormat);

# The output format that `-f NAME` asks for. (A function with a return per
# branch: Stage0 types an `if` expression whose branches are different
# classes as Any, even where both implement TableFormat.)
func output_format(name: string): TableFormat {
    if (name == "json") {
        return JsonFormat();
    }
    if (name == "csv") {
        return CsvFormat();
    }
    return TextFormat();
}

let parsed = parse_args(args());
if (parsed.is_err()) {
    printErr(i"{$ APP_NAME $}: {$ parsed.unwrap_err() $}");
    printErr(i"Try '{$ APP_NAME $} --help' for more information.");
    exit(EXIT_USAGE);
}
let opts: Options = parsed.unwrap();
if (opts.help) {
    println(usage());
    exit(EXIT_OK);
}
if (opts.version) {
    println(version_line());
    exit(EXIT_OK);
}

# Every input goes into the same Analyser, so the reports cover all files
# together. A missing, unreadable or directory input is reported and
# skipped; the others are still analysed and the exit status becomes 1.
let analyser = Analyser(if (opts.include_4xx) { 400 } else { 500 });
var status = EXIT_OK;
var inputs = 0;
for (file in opts.files) {
    let path = if (file == "-") { "/dev/stdin" } else { file };
    # Check before reading: under the self-hosted `loup run` an IoError from
    # readText cannot be caught.
    let problem = input_problem(path);
    if (problem.is_some()) {
        printErr(i"{$ APP_NAME $}: {$ file $}: {$ problem.unwrap() $}");
        status = EXIT_FAILURE;
        continue;
    }
    let name = if (file == "-") { "(standard input)" } else { file };
    # A read can still fail: a name the check could not pass to test(1), or
    # a file changed since. Interpreters that can catch the IoError (Stage0,
    # which is `loup` on macOS, Windows and Linux arm64) skip the input;
    # under the self-hosted `loup run` the run ends with the IoError.
    var text = "";
    try {
        text = readText(path);
    } catch (IoError) {
        printErr(i"{$ APP_NAME $}: {$ file $}: cannot be read");
        status = EXIT_FAILURE;
        continue;
    }
    safe {
        analyser.feed(name, text);
    }
    inputs += 1;
}
# No input was read: print no reports, only the errors above.
if (inputs == 0) {
    exit(status);
}

let tables = build_reports(analyser.stats, opts.reports, opts.top, opts.burst_threshold);
print(output_format(opts.format).render(tables));

# Malformed lines never stop the analysis. By default they cost one summary
# line on stderr; --strict lists each one and turns the status into 1.
let problems = analyser.problems;
if (problems.len() > 0 and opts.strict) {
    for (problem in problems) {
        printErr(i"{$ APP_NAME $}: {$ problem $}");
    }
    status = EXIT_FAILURE;
} else if (problems.len() > 0) {
    printErr(i"{$ APP_NAME $}: skipped {$ problems.len() $} malformed line(s) (--strict lists them)");
}
exit(status);
