@mode(host.dual)

# Application identity and exit statuses, shared by logwatch and loggen.
# Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual, but only ever interpreted here: bin/logwatch.lpscr
# and bin/loggen.lpscr import it (directly and through lib/usage.loup)
# under `loup run`. Being host.dual keeps it compilable.

pub const APP_NAME: string = "logwatch";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Analyse web server access logs in Common or Combined Log Format.";

# Exit statuses.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 2;
