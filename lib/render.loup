@mode(host.dual)

# Text and CSV output of report tables, behind the TableFormat interface
# that the JSON output (render_json.lpscr) implements too.
#
# Runtime: host.dual, but only ever interpreted here: bin/logwatch.lpscr
# imports it under `loup run`, and the unit tests under Stage0's test
# runner (`loup-bootstrap test`). It is not compilable: system.text's
# padStart and padEnd do not link natively, the list method map exists only
# in the interpreters, and natively list spread gives wrong values.
# host.dual still keeps it typed.
#
# Structure: TableFormat, whose default render() joins the tables that a
# format's table() writes; cell formatting helpers; the text renderer
# (table_text measures every column before it writes a line, and draws a
# bar for the table's bar column) and the CSV renderer (data.csv's writer
# does the quoting); then the two formats, TextFormat and CsvFormat.
#
# This module imports data.csv, which in Loup 1.26.0 makes any
# system.json `parse` in the same program run the CSV parser instead: the
# program writes JSON (render_json.lpscr) but never parses it.

from data.csv import (write);
from system.text import (padStart, padEnd);
from .reports import (Cell, Table);

const BAR_WIDTH: int = 40;

# An output format for report tables. A format that writes each table on
# its own (text, CSV) implements table() and inherits render(), which puts
# a blank line between the tables and ends with a newline; a format whose
# document is not a list of tables (JSON) overrides render() as well.
pub interface TableFormat {
    func table(t: Table): string;

    func render(tables: list[Table]): string {
        var parts: list[string] = [];
        for (t in tables) {
            parts.push(this.table(t));
        }
        return parts.join("\n\n") + "\n";
    }
}

# `333` → `33.3`.
pub func format_tenths(tenths: int): string {
    return i"{$ tenths / 10 $}.{$ tenths % 10 $}";
}

# A cell as text: a Tenths value gets a `%` sign when `percent_sign` is set.
pub func cell_text(c: Cell, percent_sign: bool): string {
    match c {
        Cell.Text(v) => {
            return v;
        },
        Cell.Count(v) => {
            return str(v);
        },
        Cell.Tenths(v) => {
            return if (percent_sign) { format_tenths(v) + "%" } else { format_tenths(v) };
        },
    }
}

func is_number(c: Cell): bool {
    match c {
        Cell.Text(v) => {
            return false;
        },
        _ => {
            return true;
        },
    }
}

func cell_count(c: Cell): int {
    match c {
        Cell.Count(v) => {
            return v;
        },
        _ => {
            return 0;
        },
    }
}

func trim_end(s: string): string {
    var end = s.len();
    while (end > 0 and s.slice(end - 1, end) == " ") {
        end -= 1;
    }
    return s.slice(0, end);
}

# `n` of `most` as a bar of up to BAR_WIDTH `#`; any non-zero n gets one.
pub func bar(n: int, most: int): string {
    if (n <= 0 or most <= 0) {
        return "";
    }
    return "#".repeat((n * BAR_WIDTH + most - 1) / most);
}

# Cells padded to their column widths, numbers on the right.
func aligned(texts: list[string], widths: list[int], right: list[bool]): string {
    var line = "";
    for (col in 0..texts.len()) {
        let s = texts[col];
        line += "  " + (if (right[col]) { padStart(s, widths[col], " ") } else { padEnd(s, widths[col], " ") });
    }
    return line;
}

# One table as text: a title, then aligned columns (numbers to the right;
# the summary, a keyed table, has no header and keeps values on the left).
pub func table_text(t: Table): string {
    var lines: list[string] = [t.title];
    if (t.rows.len() == 0) {
        lines.push("  (none)");
        return lines.join("\n");
    }

    var cells: list[list[string]] = [];
    for (row in t.rows) {
        var texts: list[string] = [];
        for (c in row) {
            texts.push(cell_text(c, true));
        }
        cells.push(texts);
    }

    # A column is as wide as its widest cell, and its name unless the table
    # is keyed (no header line). It is right-aligned when its first row
    # holds a number.
    var widths: list[int] = [];
    var right: list[bool] = [];
    for (col in 0..t.columns.len()) {
        var w = if (t.keyed) { 0 } else { t.columns[col].len() };
        for (texts in cells) {
            if (texts[col].len() > w) {
                w = texts[col].len();
            }
        }
        widths.push(w);
        right.push(!t.keyed and is_number(t.rows[0][col]));
    }

    var most = 0;
    if (t.bar >= 0) {
        for (row in t.rows) {
            if (cell_count(row[t.bar]) > most) {
                most = cell_count(row[t.bar]);
            }
        }
    }

    if (!t.keyed) {
        lines.push(trim_end(aligned(t.columns, widths, right)));
    }
    for (r in 0..t.rows.len()) {
        var line = aligned(cells[r], widths, right);
        if (t.bar >= 0) {
            line += " " + bar(cell_count(t.rows[r][t.bar]), most);
        }
        lines.push(trim_end(line));
    }
    return lines.join("\n");
}

# One table as CSV: a header row, then the rows, each starting with the
# report name.
pub func table_csv(t: Table): string {
    var rows: list[list[string]] = [["report", *t.columns]];
    for (row in t.rows) {
        let fields = row.map(func(c: Cell): string { return cell_text(c, false); });
        rows.push([t.name, *fields]);
    }
    return write(rows, ",");
}

# Aligned text tables with a title each (the default output).
pub class TextFormat implements TableFormat {
    pub func table(t: Table): string {
        return table_text(t);
    }
}

# CSV, one block of rows per table.
pub class CsvFormat implements TableFormat {
    pub func table(t: Table): string {
        return table_csv(t);
    }
}
